# ============================================================================
# Instagram Status Monitor Bot — Environment Configuration
# ============================================================================
# Copy this file to ".env" and fill in real values. Never commit your real
# .env file to version control.
#
# IMPORTANT: bot_full.py and bot_reactivation.py must be run as TWO SEPARATE
# bots (each needs its own BOT_TOKEN from @BotFather) and deployed as two
# separate services. Running both with the same token will cause a
# "Conflict" error from Telegram.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Comma-separated list of authorized Telegram user IDs, each optionally with
# a time-limited duration suffix. To find a user's ID: have them message the
# bot, then visit https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# and look for "from":{"id": ...}
#
# Format: user_id[:duration],user_id[:duration],...
#   - No suffix = permanent/lifetime access
#   - :1d = expires 1 day after the bot starts up
#   - :12h = expires 12 hours after the bot starts up
#   - :30m = expires 30 minutes after the bot starts up
AUTHORIZED_CHAT_IDS=111111111,222222222:1d,333333333:12h

# How often (in seconds) to poll monitored Instagram accounts.
# Default: 300 (5 minutes). Customize this directly in Render's Environment
# tab — no code changes or redeploy-from-scratch needed, just update this
# value and Render will restart the service with the new setting.
POLL_INTERVAL_SECONDS=300

# Timeout (in seconds) for each API request
API_TIMEOUT_SECONDS=20

# Number of consecutive poll cycles a new status must be observed before it
# is treated as a confirmed change (reduces false alarms from any one-off
# glitch). Default: 2
CONFIRMATION_THRESHOLD=2

# Path to the local JSON file used to persist monitored accounts.
# When running via Docker, this is automatically set to /app/data/... — only
# change this if running the bot directly without Docker.
DATA_FILE=monitored_accounts.json

# Folder for generated stat-card images (ephemeral is fine — these are
# regenerated on demand, nothing depends on them surviving a restart)
CARDS_DIR=cards

# ----------------------------------------------------------------------------
# Upstash Redis (free tier) — makes monitored-account data survive
# restarts/redeploys on hosts with no persistent disk (e.g. Render free
# tier). Get these from your Upstash database's "REST API" tab. If left
# blank, the bot falls back to the local DATA_FILE above, which resets on
# every redeploy on hosts without a persistent disk.
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# Branding (NEW — replaces the old BOT_SIGNATURE var, which no longer exists)
# ----------------------------------------------------------------------------
BOT_FOOTER_TEXT=Instagram Monitor — Premium Monitoring

# Custom/premium Telegram emoji (optional). Each can be a plain unicode
# emoji (used as-is) or a numeric Telegram custom emoji ID (wrapped so
# Telegram Premium users see your custom emoji, everyone else sees the
# unicode fallback automatically). Leave blank to just use the defaults
# shown here.
EMOJI_VERIFIED=✅
EMOJI_TROPHY=🏆
EMOJI_CLOCK=⏰
EMOJI_SKULL=💀
EMOJI_GRAVE=⚰️
EMOJI_WARNING=⚠️
